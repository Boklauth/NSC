")
?NSC
# Get the data from a pre-written query
y <- dbGetQuery(con,
"
select  first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD',
from odsmgr.mst_person
")
# Get the data from a pre-written query
y <- dbGetQuery(con,
"
select  first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD'
from odsmgr.mst_person
")
# Get the data containing 100 rows from the database via Oracle
y <- dbGetQuery(con,
"
SELECT  DISTINCT    first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD',
person_uid
FROM odsmgr.mst_person
WHERE nrows <=100
")
# Get the data containing 100 rows from the database via Oracle
y <- dbGetQuery(con,
"
SELECT  DISTINCT    first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD',
person_uid
FROM odsmgr.mst_person
WHERE rownums <=100
")
# Get the data containing 100 rows from the database via Oracle
y <- dbGetQuery(con,
"
SELECT  DISTINCT    first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD',
person_uid
FROM odsmgr.mst_person
WHERE rownum <=100
")
y
# Get the data containing 100 rows from the database via Oracle
y <- dbGetQuery(con,
"
SELECT  DISTINCT    first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD',
'20210115' as search_date,
person_uid
FROM odsmgr.mst_person
WHERE rownum <=100
")
y
# Get the data containing 100 rows from the database via Oracle
y2 <- dbGetQuery(con,
"
SELECT  DISTINCT    first_name,
middle_initial,
last_name,
name_suffix,
birth_date, 'YYYYMMDD',
'20210115' as search_date,
person_uid
FROM odsmgr.mst_person
WHERE rownum <=100
")

earliest_date))
}
length(extracted_dates)
for (i in 1:length(extracted_dates)){
if (Sys.Date() - extracted_dates[i]< 59){
earliest_date <- gsub("-", "", Sys.Date()-60)
stop(paste("Your earliest search data must be at least 60 days to the current date: ",
earliest_date))
}
}

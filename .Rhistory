max.iterations <- 1000
min.range <- 0.35 # lc min value
max.range <- 0.65 # lc max value
lc <- NULL # latent correlations
f = 0
nfactors<-rep(0, n.dimensions)
while (f < n.dimensions)  {
temp_value <- rnorm(1, mean = 0, sd = 1)
if (temp_value > min.range & temp_value < max.range){
f = f+1
lc[f]<-temp_value
print(paste0('correlation value: ', lc[f]))
if (n.dimensions - f = 0){
message("all correlation values have been obtained.")
}
}
}

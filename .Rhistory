# >>>>Appendix Method 2 ####
msu2018_2020 <- group_by(fig3to8_ds, cohort) %>%
mutate(total = sum(Freq))%>%
filter(college == "Michigan State University")
msu2018_2020$percent_raw <- format(msu2018_2020$Freq/msu2018_2020$total, nsmall=4)
# save
save(msu2018_2020, file = paste0(getwd(), "/msu2018_2020.RData"))
data <- msu2018_2020
rates <- NULL
for (i in 1:2){
j <- i+1
rate <- 100*(as.numeric(data[i,6])-as.numeric(data[j,6]))
rates <- rbind(rates, rate)
}
avg_rate <- sum(rates)/2
# not enrolled ABNE students
notenrolled_and_msu <- group_by(fig3to8_ds, cohort) %>%
mutate(total = sum(Freq)) %>%
filter(college == "ZZZ not enrolled ZZZ"|
college == "Michigan State University")%>%
arrange(college, desc(cohort))
notenrolled_and_msu$percent <- format(notenrolled_and_msu$Freq/notenrolled_and_msu$total, nsmall=4)
mydf <- notenrolled_and_msu
mydf$rate <- NA
for (i in 1:2){
j <- i+1
mydf$rate[i] <- 100*(as.numeric(mydf[i,6]) - as.numeric(mydf[j,6]))
}
for (i in 4:6){
j <- i+1
mydf$rate[i] <- 100*(as.numeric(mydf[i,6]) - as.numeric(mydf[j,6]))
}
mydf[mydf=="ZZZ not enrolled ZZZ"] <- "HE Stopouts"
setwd(working_dir)
getwd()
save(mydf, file = paste0(getwd(), "/mydf.RData"))
# get structure and total for MSU
msu2021 <- group_by(fig3to8_ds, cohort) %>%
mutate(total = sum(Freq)) %>%
filter(college == "ZZZ not enrolled ZZZ") %>%
filter(cohort=="2021")
# change college name to MSU
msu2021[msu2021=="ZZZ not enrolled ZZZ"] <- "Michigan State University"
msu2021[msu2021=="0"] <- "4"
p2021 <- avg_rate + 100*as.numeric(msu2018_2020[1,6])
msu2021$Freq <- round(msu2021$total*p2021/100, 0)
msu2021_final <- msu2021[,1:4] # for row binding
# combine college_bar_by_cohort and msu2021 and calculate percentage
head(fig3to8_ds)
head(predicted_colleges)
predicted_colleges <- rbind(fig3to8_ds, msu2021_final)
head(predicted_colleges)
# make adjustment to not enrolled
predicted_colleges[predicted_colleges==3792] = 3792-msu2021$Freq
predicted_collegesp <- predicted_colleges %>%
group_by(cohort) %>%
mutate(total = sum(Freq)) %>%
mutate(percent = round(100*Freq/sum(Freq),1)) %>%
filter(college != "ZZZ not enrolled ZZZ") %>% # remove not enrolled
arrange(desc(Freq))
head(predicted_collegesp)
head(predicted_collegesp)
# we can use the the table to make graph out of it.
# >>>>Figure7 predicted MSU graph####
# select 15 highest rankings
for(j in 1:1){ # j array is for helping me run code: Ctrl + Enter
cohort_value <- c(2021)
temps <- NULL
i <- 1
for (i in 1:length(cohort_value)){
temp <- predicted_collegesp %>%
filter(cohort == cohort_value[i]) %>%
arrange(cohort, desc(Freq)) %>%
top_n(15) # this one can get 11 colleges if the values are equal, like ranking
#filter(Freq >=4)
name_temp <- paste0("topcolleges", cohort_value[i])
assign(name_temp, temp)
write_rds(get(name_temp),
file = paste0(getwd(), '/', name_temp, '.rds'))
cohort_total <- matrix(temp %>% select(total) %>% unique(),ncol=2)[2]
data <- get(name_temp)
topcollege_graph <- ggplot(
data = data,
aes(fct_reorder(college, percent), percent)) +
geom_col(aes(fill = X2year4year), alpha = 0.8) +
coord_flip() +
scale_fill_manual(
name = 'College Type',
values = c('#442416','#eeb111'),
breaks = c('2', '4'),
labels = c("2 Year   ", "4 Year")) +
scale_y_continuous(
name = NULL,
expand = c(0,0),
limits = c(0, 22), # x axis limit
breaks = c(0, 5, 10, 15)) +
scale_x_discrete(
name = NULL,
expand = c(0, 0.5)) +
labs(
title = paste0("Total Frequencies for ", cohort_value[i], " = ", cohort_total),
caption = "") +
theme_minimal() +
theme(
plot.title = element_text(size = 10),
plot.caption = element_text(size = 10),
legend.title = element_text(size = 10),
legend.key.size = unit(.35, "cm"),
axis.title = element_text(size = 10),
axis.text = element_text(size = 10),
axis.text.y = element_text(lineheight = 1.3),
axis.ticks.y = element_blank(),
legend.position = c(0.55, 0.2))+
# add percentages
geom_text(
label=paste0(data$percent, "%"),
nudge_x = 0.1, nudge_y = 1,
check_overlap = T,
size = 3.4)
setwd(working_dir)
getwd()
graph_name <- paste0("predicted_topcollege_graph", cohort_value[i])
assign(graph_name, topcollege_graph)
write_rds(get(graph_name),
file = paste0(getwd(), '/output/', graph_name, '.rds'))
}
}

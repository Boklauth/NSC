# select top x colleges for all years
cohort_value <- c(2018, 2019, 2020, 2021)
temps <- NULL
for (i in 1:length(cohort_value)){
temp <- predicted_collegesp %>%
filter(cohort == cohort_value[i]) %>%
arrange(cohort, desc(Freq)) %>%
top_n(12)
temps <- rbind(temps, temp)
}
freq_colleges <- as.data.frame(table(temps$college))%>%
filter(Freq>=3)
temps2 <- temps %>%
filter(college %in% freq_colleges$Var1)
temps2
freq_colleges <- as.data.frame(table(temps$college))%>%
filter(Freq>=3)
temps2 <- temps %>%
filter(college %in% freq_colleges$Var1)
temps2
mydata <- temps2%>%
mutate(college = str_replace(college, 'Community College', '\nCommunity College'),
college = str_replace(college, 'State University', '\nState University'),
college = str_replace(college, 'Michigan University', '\nMichigan University'),
college = str_replace(college, 'Technological University', '\nTechnological University'))
figure8 <- ggplot(mydata, aes(x = cohort, y = percent,
group = X2year4year, colour = X2year4year)) +
geom_point(show.legend = TRUE)+
geom_line(size= 1, show.legend = TRUE)+
facet_wrap( ncol = 3, ~ fct_reorder(college, desc(percent))) +
# facet_grid(~fct_reorder(college, desc(percent)))+
# scale_colour_manual(values = c('#442416','#eeb111')) +
scale_color_manual(
name = 'College Type    ',
values = c('black','#eeb111'),
breaks = c('2', '4'),
labels = c("2 Year   ", "4 Year")) +
labs(title="",
subtitle = "")+
xlab("Cohort")+ylab("Percent")+
scale_y_continuous(
name = NULL,
expand = c(0,0),
limits = c(0, 25),
breaks = c( 0, 10, 20),
labels = c('0%', '10%', '20%')) +
theme_minimal(base_family = "") +
theme(
plot.title = element_text(size = 10),
plot.caption = element_text(size = 9, hjust = 0),
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
strip.text = element_text(size = 8),
axis.ticks.y = element_blank(),
legend.title = element_text(size = 9),
legend.position = 'bottom',
legend.justification = 'right')
figure8
# write output out
setwd(working_dir)
getwd()
write_rds(figure8,
file = paste0(getwd(), '/output/figure8.rds'))
